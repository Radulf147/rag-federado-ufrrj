# Modelo deste arquivo. Copie para `.env` e preencha DCC_USUARIO.
#
#     cp .env.example .env
#
# O `.env` de verdade NÃO é versionado (ver .gitignore): ele carrega o usuário
# do DCC. Este molde existe porque, sem ele, quem clonasse o repositório não
# teria como saber que variáveis o projeto espera — e a falta de algumas não dá
# erro, muda o comportamento em silêncio. LIMIAR_DISTANCIA ausente desliga o
# filtro da busca semântica; MODELO_EMBEDDING ausente faz o ETL vetorizar com
# outro modelo, em outra dimensão, sem reclamar.
#
# Os valores abaixo são os que estavam em uso em 4 set 2026.

# --- LLM -----------------------------------------------------------------
# Escolhido por medição, não por estimativa: o gpt-oss:20b não emitia resposta
# final em 2 de 3 perguntas interpretativas. Ver CLAUDE.md §2.
MODELO_LLM=qwen2.5:32b-instruct-q4_K_M

# Janela de contexto. O padrão do Ollama (4096) é apertado para TOP_K=10.
NUM_CTX=8192

# auto | off | low | medium | high — só afeta modelos com raciocínio.
# `auto` não envia o parâmetro `think`, que é o certo para o qwen2.5.
REASONING_EFFORT=auto

# --- Embedding e recuperação ---------------------------------------------
MODELO_EMBEDDING=BAAI/bge-m3
EMBEDDING_DIM=1024
TOP_K=10

# Limiar de DISTÂNCIA da busca semântica — menor é mais parecido, e o filtro
# é `score <= limiar`. Calibrado em docs/calibracao_limiar.md; vazio desliga.
# Escrever a comparação na direção intuitiva descartaria os relevantes.
LIMIAR_DISTANCIA=1.24

# --- Infraestrutura -------------------------------------------------------
# O Ollama roda na máquina da faculdade, alcançada pelo túnel SSH (./rag.sh
# tunel up). Dentro do container, localhost:9999 vira host.docker.internal.
OLLAMA_HOST=http://host.docker.internal:9999
CHROMA_REMOTE=True

# Usuário do DCC, usado por tunel.sh. Sem isto o túnel recusa a subir.
DCC_USUARIO=seu.usuario
